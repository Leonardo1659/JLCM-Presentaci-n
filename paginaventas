<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JLCM - Desarrollo Web Profesional</title>
    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b0f19;
            color: #f8fafc;
            overflow-x: hidden;
        }

        .navbar {
            background-color: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 50;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .navbar .logo-nav {
            color: #3b82f6;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 2px;
            text-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
        }

        .hero {
            background: radial-gradient(circle at 50% 50%, #1e1b4b 0%, #0f172a 100%);
            color: white;
            padding: 120px 20px;
            text-align: center;
            min-height: 85vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 20%;
            width: 300px;
            height: 300px;
            background: #4f46e5;
            border-radius: 50%;
            filter: blur(150px);
            opacity: 0.15;
            z-index: 1;
        }

        .marca-personal {
            color: #60a5fa; 
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 6px; 
            margin-bottom: 25px;
            text-transform: uppercase;
            background: rgba(59, 130, 246, 0.1);
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid rgba(59, 130, 246, 0.2);
            z-index: 2;
        }

        .hero h1 {
            font-size: 52px;
            font-weight: 800;
            margin-bottom: 25px;
            max-width: 900px;
            line-height: 1.2;
            letter-spacing: -1px;
            background: linear-gradient(135deg, #ffffff 40%, #93c5fd 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            z-index: 2;
        }

        .hero p {
            font-size: 19px;
            color: #94a3b8;
            margin-bottom: 45px;
            max-width: 650px;
            line-height: 1.6;
            z-index: 2;
        }

        .btn-principal {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white;
            padding: 18px 45px;
            font-size: 16px;
            font-weight: 700;
            border: none;
            border-radius: 50px;
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            z-index: 2;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-principal:hover {
            transform: translateY(-3px); 
            box-shadow: 0 15px 30px rgba(37, 99, 235, 0.6);
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        }

        .info-section {
            max-width: 1100px;
            margin: -80px auto 80px auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .grid-beneficios {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .tarjeta {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            padding: 40px 30px;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }

        .tarjeta:hover {
            transform: translateY(-5px);
            border-color: rgba(59, 130, 246, 0.3);
            box-shadow: 0 20px 40px rgba(37, 99, 235, 0.1);
        }

        .tarjeta .icono {
            font-size: 36px;
            margin-bottom: 20px;
            display: inline-block;
            background: rgba(255, 255, 255, 0.03);
            padding: 15px;
            border-radius: 12px;
        }

        .tarjeta h3 {
            font-size: 22px;
            margin-bottom: 15px;
            color: #ffffff;
            font-weight: 700;
        }

        .tarjeta p {
            font-size: 15px;
            color: #94a3b8;
            line-height: 1.7;
        }

        .formulario-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .formulario-overlay.mostrar {
            opacity: 1;
            visibility: visible;
        }

        .form-container {
            background-color: #1e293b;
            width: 100%;
            max-width: 700px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 45px 40px 40px 40px;
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            position: relative;
            transform: translateY(40px);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .formulario-overlay.mostrar .form-container {
            transform: translateY(0);
        }

        .btn-cerrar-form {
            position: absolute;
            top: 20px;
            right: 25px;
            background: none;
            border: none;
            font-size: 32px;
            color: #64748b;
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .btn-cerrar-form:hover { color: #ffffff; }

        .titulo-form {
            text-align: center;
            margin-bottom: 30px;
        }

        .titulo-form h2 { font-size: 28px; color: #ffffff; font-weight: 700; }
        .titulo-form p { color: #94a3b8; font-size: 15px; margin-top: 8px; }

        form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group { display: flex; flex-direction: column; }
        .full-width { grid-column: span 2; }

        label {
            font-size: 13px;
            color: #cbd5e1;
            margin-bottom: 8px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        input, textarea {
            width: 100%;
            padding: 13px 16px;
            background-color: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: #ffffff;
            font-size: 14px;
            outline: none;
            transition: all 0.3s ease;
        }

        input:focus, textarea:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
        }

        textarea { resize: vertical; min-height: 110px; }
        .error-msg { color: #ef4444; font-size: 12px; margin-top: 6px; display: none; font-weight: 500; }

        .submit-btn {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white;
            border: none;
            padding: 16px;
            font-size: 16px;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 10px;
        }

        .submit-btn:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
        }

        .submit-btn:disabled { background-color: #475569; cursor: not-allowed; box-shadow: none; }

        .modal-exito-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(4px);
            display: flex; justify-content: center; align-items: center;
            opacity: 0; visibility: hidden; transition: all 0.4s ease;
            z-index: 150;
        }

        .modal-exito-content {
            background-color: #1e293b;
            padding: 45px 40px;
            border-radius: 16px;
            text-align: center;
            transform: scale(0.9);
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            max-width: 450px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
        }

        .modal-exito-overlay.active { opacity: 1; visibility: visible; }
        .modal-exito-overlay.active .modal-exito-content { transform: scale(1); }
        
        .modal-exito-content h2 {
            color: #ffffff;
            font-size: 28px;
            font-weight: 800;
        }

        .modal-btn {
            margin-top: 15px;
            padding: 14px 30px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            font-size: 15px;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            width: 100%;
        }

        .modal-btn:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.3);
        }

        @media (max-width: 600px) {
            form { grid-template-columns: 1fr; }
            .full-width { grid-column: span 1; }
            .hero h1 { font-size: 34px; }
            .hero p { font-size: 16px; }
            .form-container { padding: 35px 20px; }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="logo-nav">JLCM</div>
    </nav>

    <header class="hero">
        <div class="marca-personal">JLCM</div>
        <h1>Creamos páginas web profesionales que hacen crecer tu negocio</h1>
        <p>Llega a más clientes, digitaliza tus servicios y obtén un diseño a medida con soporte garantizado.</p>
        <button class="btn-principal" id="btnAbrirFormulario">Haz tu solicitud aquí</button>
    </header>

    <section class="info-section">
        <div class="grid-beneficios">
            
            <div class="tarjeta">
                <div class="icono">🎨</div>
                <h3>Diseño Exclusivo</h3>
                <p>No usamos plantillas repetidas. Interfaces visuales personalizadas adaptadas a la identidad de tu marca.</p>
            </div>

            <div class="tarjeta">
                <div class="icono">⚙️</div>
                <h3>Sistemas a Medida</h3>
                <p>Desde páginas informativas hasta sistemas web avanzados conectados a tus bases de datos de control administrativo.</p>
            </div>

            <div class="tarjeta">
                <div class="icono">📱</div>
                <h3>Optimización Total</h3>
                <p>Páginas web seguras y adaptables para que se vean perfectas en cualquier celular, tablet o computadora.</p>
            </div>

        </div>
    </section>

    <div class="formulario-overlay" id="capaFormulario">
        <div class="form-container">
            <button class="btn-cerrar-form" id="btnCerrarFormulario">&times;</button>

            <div class="titulo-form">
                <h2>Cuéntanos sobre tu proyecto</h2>
                <p>Llena los datos a continuación para registrar tu requerimiento en Google Sheets.</p>
            </div>

            <form id="formularioVentas">
                <div class="form-group">
                    <label for="nombre">Nombre Completo</label>
                    <input type="text" id="nombre" required>
                </div>
                <div class="form-group">
                    <label for="ci">Carnet de Identidad</label>
                    <input type="text" id="ci" required>
                    <span class="error-msg" id="errorCi">El carnet solo debe contener números.</span>
                </div>
                <div class="form-group">
                    <label for="correo">Correo Electrónico</label>
                    <input type="email" id="correo" required>
                </div>
                <div class="form-group">
                    <label for="telefono">Teléfono</label>
                    <input type="tel" id="telefono" required>
                </div>
                <div class="form-group full-width">
                    <label for="requerimientos">Requerimientos (¿Cómo quieres tu página?)</label>
                    <textarea id="requerimientos" placeholder="Ej: Necesito una página web para mi negocio con pasarela de pagos..." required></textarea>
                </div>
                <div class="form-group full-width">
                    <label for="archivo">Adjuntar Idea o Boceto (Opcional)</label>
                    <input type="file" id="archivo" accept="image/*,.pdf,.doc,.docx">
                </div>
                <div class="form-group full-width">
                    <button type="submit" class="submit-btn" id="btnEnviar">Enviar Solicitud</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-exito-overlay" id="modalExito">
        <div class="modal-exito-content">
            <h2>¡Solicitud Recibida!</h2>
            <p style="margin-top: 15px; line-height: 1.6; color: #94a3b8; font-size: 15px;">
                Tu requerimiento ha sido registrado con éxito en nuestro sistema y se encuentra en estado <strong>"Pendiente"</strong>.<br><br>
                Nuestro equipo técnico revisará tu propuesta a la brevedad. Por favor, <strong>espera a recibir una respuesta</strong> directamente en tu WhatsApp. ¡Gracias por confiar en JLCM!
            </p>
            <button class="modal-btn" id="btnCerrarModal">Entendido</button>
        </div>
    </div>

    <script>
        const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyAzHuVUHRa-Assyq4PBuNqRrUmg_rqf6c5P_WA5rxHk9GJ40U-yPteEluFiiDQfrU_/exec';

        const btnAbrirFormulario = document.getElementById('btnAbrirFormulario');
        const btnCerrarFormulario = document.getElementById('btnCerrarFormulario');
        const capaFormulario = document.getElementById('capaFormulario');
        const formulario = document.getElementById('formularioVentas');
        const inputCi = document.getElementById('ci');
        const errorCi = document.getElementById('errorCi');
        const btnEnviar = document.getElementById('btnEnviar');
        const modalExito = document.getElementById('modalExito');
        const btnCerrarModal = document.getElementById('btnCerrarModal');

        btnAbrirFormulario.addEventListener('click', function() {
            capaFormulario.classList.add('mostrar');
        });

        btnCerrarFormulario.addEventListener('click', function() {
            capaFormulario.classList.remove('mostrar');
        });

        formulario.addEventListener('submit', function(evento) {
            evento.preventDefault(); 
            const valorCi = inputCi.value;
            if (/[^0-9]/.test(valorCi)) {
                errorCi.style.display = 'block';
                inputCi.style.borderColor = '#dc2626';
                return; 
            } else {
                errorCi.style.display = 'none';
                inputCi.style.borderColor = '#cbd5e1';
            }

            btnEnviar.textContent = "Procesando y subiendo...";
            btnEnviar.disabled = true;

            const archivoInput = document.getElementById('archivo');
            const file = archivoInput.files[0];

            const enviarPayload = (base64Data = "", fileName = "", fileMimeType = "") => {
                const payload = {
                    nombre: document.getElementById('nombre').value,
                    ci: document.getElementById('ci').value,
                    correo: document.getElementById('correo').value,
                    telefono: document.getElementById('telefono').value,
                    requerimientos: document.getElementById('requerimientos').value,
                    fileData: base64Data,
                    fileName: fileName,
                    fileMimeType: fileMimeType
                };

                fetch(SCRIPT_URL, {
                    method: 'POST',
                    body: JSON.stringify(payload)
                })
                .then(res => res.json())
                .then(response => {
                    if(response.status === 'success') {
                        capaFormulario.classList.remove('mostrar');
                        modalExito.classList.add('active');
                        formulario.reset();
                    } else {
                        alert('Error en Google Sheets: ' + response.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error de conexión.');
                })
                .finally(() => {
                    btnEnviar.textContent = "Enviar Solicitud";
                    btnEnviar.disabled = false;
                });
            };

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    enviarPayload(e.target.result, file.name, file.type);
                };
                reader.readAsDataURL(file);
            } else {
                enviarPayload();
            }
        });

        btnCerrarModal.addEventListener('click', function() {
            modalExito.classList.remove('active');
        });
    </script>
</body>
</html>
